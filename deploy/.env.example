# Copy this file to .env on the deployment host and set the exact public HTTPS origin.
# The loopback-only port is reached by the selected host-level HTTPS tunnel or proxy.
LEAVE_PLANNER_BIND_ADDRESS=127.0.0.1
LEAVE_PLANNER_HTTP_PORT=8080
LEAVE_PLANNER_PUBLIC_ORIGIN=https://app.merydio.co.uk
LEAVE_PLANNER_VERSION=0.2.1
# Set this to the immutable digest inspected from the official cloudflared image.
# CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:replace-after-inspection
