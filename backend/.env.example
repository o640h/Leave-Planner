# Local development continues to use SQLite when DATABASE_URL is omitted.
# Hosted production must use the explicit psycopg driver shown below.
LEAVE_PLANNER_ENVIRONMENT=production
LEAVE_PLANNER_REGISTRATION_MODE=open
LEAVE_PLANNER_OWNED_WORKSPACE_LIMIT=3
LEAVE_PLANNER_DATABASE_URL=postgresql+psycopg://leave_planner:replace-with-a-secret@database:5432/leave_planner
# Containers use LEAVE_PLANNER_DATABASE_URL_FILE instead so the URL is read from a mounted secret.
